<UserControl x:Class="WindowsShuffle.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Background="#101216">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#191D23"
                BorderBrush="#303640"
                BorderThickness="0,0,0,1">

            <Grid Margin="9,0">
                <TextBlock Text="Notes"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBlock Text="NEW"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#69A9E8"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Notes content -->
        <Grid Grid.Row="1" Margin="10">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="No Notes"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#E6E6E6"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Your notes will appear here."
                           FontSize="10"
                           Foreground="#858B95"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#191D23"
                BorderBrush="#303640"
                BorderThickness="0,1,0,0">

            <Button Content="Back"
                    Click="Back_Click"
                    Background="Transparent"
                    Foreground="#D7DCE3"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Focusable="False"
                    BorderThickness="0">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="1">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder"
                                        Property="Background"
                                        Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</UserControl>
