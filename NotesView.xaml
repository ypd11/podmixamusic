<UserControl x:Class="WindowsShuffle.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Background="#101216">

        <Grid.RowDefinitions>
            <!-- Header: same layout as Lyrics -->
            <RowDefinition Height="34"/>

            <!-- Main content -->
            <RowDefinition Height="*"/>

            <!-- Footer -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Notes"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,6,0,0"/>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Margin="10,0,10,5">

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="No Notes"
                           Foreground="#E6E6E6"
                           FontWeight="SemiBold"
                           FontSize="13"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Your notes will appear here."
                           Foreground="#858B95"
                           FontSize="10"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#191D23"
                BorderBrush="#303640"
                BorderThickness="0,1,0,0">

            <Button Content="Back"
        Click="Back_Click"
        Background="Transparent"
        Foreground="White"
        BorderThickness="0"
        FontSize="11"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="10,2"
        Cursor="Hand"
        Focusable="False">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                    Background="Transparent"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder"
                            Property="Background"
                            Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>

    </Grid>
</UserControl>
