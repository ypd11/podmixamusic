<UserControl x:Class="WindowsShuffle.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Width="254"
             Height="214">

    <Grid Background="#F4F1E8">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#E8E3D6"
                BorderBrush="#D5CFBF"
                BorderThickness="0,0,0,1">

            <Grid Margin="9,0">
                <TextBlock Text="Notes"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#343434"
                           VerticalAlignment="Center"/>

                <TextBlock Text="NEW"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#527A9D"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Notes content -->
        <Grid Grid.Row="1" Margin="10">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <TextBlock Text="No Notes"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#555555"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Your notes will appear here."
                           FontSize="10"
                           Foreground="#888888"
                           Margin="0,5,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Back footer -->

        <Border Grid.Row="2"
        Background="#E8E3D6"
        BorderBrush="#D5CFBF"
        BorderThickness="0,1,0,0">

            <Button Content="Back"
            Click="Back_Click"
            Background="Transparent"
            BorderThickness="0"
            Foreground="#527A9D"
            FontSize="11"
            FontWeight="SemiBold"
            Cursor="Hand"
            Focusable="False"/>
        </Border>

    </Grid>
</UserControl>
