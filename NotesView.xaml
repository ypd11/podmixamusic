<UserControl x:Class="WindowsShuffle.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid Background="#101216">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Notes"
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,6,0,0"/>

        <!-- Notes list / empty state -->
        <Grid Grid.Row="1" Margin="8,2,8,5">

            <TextBlock x:Name="TxtEmpty"
                       Text="No Notes&#10;Your notes will appear here."
                       Foreground="#858B95"
                       FontSize="11"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       LineHeight="17"
                       Visibility="Collapsed"/>

            <ScrollViewer x:Name="NotesScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl x:Name="NotesList">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#191D23"
                                    BorderBrush="#303640"
                                    BorderThickness="0,0,0,1"
                                    Padding="7,5"
                                    Margin="0,0,0,2">

                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="#F2F2F2"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Content}"
                                               Foreground="#9299A4"
                                               FontSize="9"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="13"/>

                                    <TextBlock Text="{Binding DateModified, StringFormat='{}{0:MMM d, yyyy}'}"
                                               Foreground="#626B78"
                                               FontSize="8"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>
            </ScrollViewer>


            <Button x:Name="BtnNewNote"
        Content="+"
        Width="32"
        Height="32"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,5,5"
        Background="#2878D0"
        Foreground="White"
        BorderThickness="0"
        FontSize="23"
        FontWeight="Light"
        Cursor="Hand"
        Focusable="False"
        Click="NewNote_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="16">
                            <ContentPresenter
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,-2,0,0"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#3992ED"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                            Property="Opacity"
                            Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#191D23"
                BorderBrush="#303640"
                BorderThickness="0,1,0,0">

            <Button Content="Back"
                    Click="Back_Click"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="10,2"
                    Cursor="Hand"
                    Focusable="False">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder"
                                        Property="Background"
                                        Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>

    </Grid>
</UserControl>
