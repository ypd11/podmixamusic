<Window x:Class="WindowsShuffle.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloads" Height="600" Width="420" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Modern Search Box Template -->
        <ControlTemplate x:Key="IosSearchBox" TargetType="{x:Type TextBox}">
            <Border x:Name="border" Background="#2C2C2E" CornerRadius="10" BorderThickness="1" BorderBrush="#3A3A3C">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" Foreground="#8E8E93" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,10,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#3A3A3C"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#0A84FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Custom ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#44FFFFFF" CornerRadius="3" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem Styling -->
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Toggle Style -->
        <Style x:Key="SegmentedButtonStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1C1C1E" CornerRadius="20" BorderBrush="#38383A" BorderThickness="1.2">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Toggle -->
                <RowDefinition Height="Auto"/>
                <!-- Search Area -->
                <RowDefinition Height="Auto"/>
                <!-- Status Text -->
                <RowDefinition Height="*"/>
                <!-- Content Area -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Button Click="Exit_Click" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate>
                            <Ellipse Fill="#FF5F57"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Music Downloader" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Grid>

            <!-- Toggle Switch -->
            <Border Grid.Row="1" Background="#2C2C2E" CornerRadius="10" Padding="2" HorizontalAlignment="Center" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RadSong" Content="Songs" IsChecked="True" Checked="Mode_Checked" Style="{StaticResource SegmentedButtonStyle}" Width="100"/>
                    <RadioButton x:Name="RadPlaylist" Content="Playlist" Checked="Mode_Checked" Style="{StaticResource SegmentedButtonStyle}" Width="100"/>
                </StackPanel>
            </Border>

            <!-- Search Input Area -->
            <Grid Grid.Row="2" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchInput" 
                         Height="36" 
                         Foreground="White" 
                         FontSize="14"
                         Template="{StaticResource IosSearchBox}"
                         VerticalContentAlignment="Center"
                         KeyDown="SearchInput_KeyDown"/>

                <Button Grid.Column="1" Click="DoSearch_Click" Margin="10,0,0,0" 
                        Content="Search" Foreground="#0A84FF" FontWeight="SemiBold" FontSize="14" Background="Transparent" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Search Status Text -->
            <TextBlock Grid.Row="3" x:Name="TxtSearchStatus" 
                       Text="Search YouTube" 
                       Foreground="#8E8E93"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="0,10,0,10" 
                       FontSize="13"/>

            <!-- Content Area -->
            <Grid Grid.Row="4">
                <!-- Search Results View -->
                <Grid x:Name="ResultsView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="ListResults" Background="Transparent" BorderThickness="0" 
                             SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0">
                                        <Ellipse Fill="#2C2C2E"/>
                                        <TextBlock Text="♪" Foreground="#444" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"/>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Author}" Foreground="#8E8E93" FontSize="11" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#666666" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pagination: Load More Button -->
                    <Button x:Name="BtnLoadMore" Grid.Row="1" Content="Load More Results" Click="LoadMore_Click" 
                            Foreground="#0A84FF" FontSize="12" FontWeight="SemiBold" Background="Transparent" BorderThickness="0" 
                            Cursor="Hand" Margin="0,5" Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnAddToQueue" Grid.Row="2" Visibility="Collapsed" Content="Add Selected to Queue" Click="AddToQueue_Click" 
                            Background="#0070BA" Foreground="White" Height="30" Margin="0,10,0,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Active Downloads View -->
                <ListBox x:Name="ListDownloads" Visibility="Collapsed" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse Fill="#2C2C2E"/>
                                    <TextBlock Text="↓" Foreground="#444" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"/>
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Author}" Foreground="#8E8E93" FontSize="11" Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="#0A84FF" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Download" Click="StartDownload_Click" 
                                            Visibility="{Binding ShowDownloadButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="#0070BA" Foreground="White" 
                                            Width="70" Height="24" Cursor="Hand" Margin="0,0,10,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Click="CancelDownload_Click" Width="24" Height="24" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Ellipse Fill="#3A3A3C" x:Name="bg"/>
                                                    <TextBlock Text="✕" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Fill" Value="#FF453A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Footer Section -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="BtnViewToggle" Content="Show Queue" Click="ToggleView_Click" 
                        Background="#0070BA" Foreground="White" 
                        Width="100" Height="26" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Open Folder" Click="OpenFolder_Click" 
                        Background="#0070BA" Foreground="White" 
                        Width="100" Height="26" Cursor="Hand" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Clear All" Click="ClearCompleted_Click" 
                        Background="#0070BA" Foreground="White" 
                        Width="80" Height="26" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
